{
  "name": "vans-ai-studio",
  "version": "1.0.0",
  "description": "Free AI studio - images, video, music, 3D models & custom style models. No API key needed.",
  "main": "electron/main.js",
  "author": "Vans AI Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deanavraham-bit/Vans-Ai-Studio.git"
  },
  "scripts": {
    "start": "electron .",
    "web": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/serve.ps1 -Port 8765 -Open",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vans.aistudio",
    "productName": "Vans AI Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png",
      "artifactName": "VansAiStudio-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "VansAiStudio-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "identity": null,
      "category": "public.app-category.graphics-design",
      "artifactName": "VansAiStudio-${version}-mac.dmg"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Graphics",
      "artifactName": "VansAiStudio-${version}.AppImage"
    }
  }
}
